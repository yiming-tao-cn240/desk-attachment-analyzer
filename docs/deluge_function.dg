// ============================================================
// Zoho Desk Deluge 自定义函数 (精简版)
// 功能：将工单ID传给Catalyst，由Catalyst完成全部分析与打标签
// 触发方式：工作流规则 - 工单创建时触发
// ============================================================

// ---------- 参数说明 ----------
// ticketId: 工单ID（从工作流规则中传入，映射到 #ticket.ticketId#）
// orgId:    Desk 组织ID（在自定义函数参数中填入）

requestBody = Map();
requestBody.put("ticketId", ticketId);
requestBody.put("orgId", orgId);

catalystResponse = invokeurl
[
    url: "https://desk-attachment-analyzer-787233720.development.catalystserverless.com/server/analyze_attachment/"
    type: POST
    headers: {"Content-Type": "application/json"}
    body: requestBody.toString()
];

info "Catalyst 处理结果: " + catalystResponse;
